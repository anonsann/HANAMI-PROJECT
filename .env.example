# Copy to `.env` when developing behind a TLS reverse proxy (cloud sandboxes,
# tunnels, etc.). Plain localhost development needs none of these.

# HMR over websockets stuck on http:// will fail through an https:// proxy —
# upgrade to secure websockets and match the exposed port:
VITE_HMR_PROTOCOL=wss
VITE_HMR_CLIENT_PORT=443

# You may also point the whole app at the VNDB beta sandbox at runtime via
# Settings → Connection (no env variable needed).
